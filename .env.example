# LLM API Keys (set at least one)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# LLM Defaults
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.0-flash"

# Embedding (optional, defaults to local sentence-transformers)
# EMBED_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."

# Optional decision model (off by default). Typed yes/no / choice / score
# for loop grade + verify gates only — not HyDE, not a chat LLM replacement.
# CODEHARNESS_DECISION_ENABLED=1
# CODEHARNESS_DECISION_PROVIDER=jev
# CODEHARNESS_DECISION_API_KEY=
# TYPESAFE_API_KEY=
# JEV_API_KEY=
# CODEHARNESS_DECISION_API_BASE=
# CODEHARNESS_DECISION_MODEL=jev-latest
# CODEHARNESS_DECISION_TIMEOUT_MS=2000
# CODEHARNESS_DECISION_MIN_CONFIDENCE=0.0
# CODEHARNESS_DECISION_USES=loop_grade,verify
