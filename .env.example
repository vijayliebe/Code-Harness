# LLM keys are optional for index, eval, doctor, and query --no-llm.
# Copying this file to .env overrides harness/config.py defaults via load_dotenv().
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# LLM overrides (code default: openai / gpt-4o). Gemini remap when
# provider=gemini and model is still gpt-4o: gemini-2.5-flash.
# LLM_PROVIDER="openai"
# LLM_MODEL="gpt-4o"

# Embedding: default is local all-MiniLM-L6-v2 (384-d).
# Do not set jina-code as a default until `make eval-ab-embed` justifies it.
# CODEHARNESS_EMBED_MODEL=jina-code
# Voyage / Jina *API* (not the local Jina-code A/B): set embedding.provider in config.
# VOYAGE_API_KEY=
# JINA_API_KEY=

# Optional decision model (off by default). Typed yes/no / choice / score
# for loop grade + verify gates only — not HyDE, not a chat LLM replacement.
# Do not set ENABLED=1 as a repo default until loop/verify eval justifies it.
# CODEHARNESS_DECISION_ENABLED=1
# CODEHARNESS_DECISION_PROVIDER=jev
# CODEHARNESS_DECISION_API_KEY=
# TYPESAFE_API_KEY=
# JEV_API_KEY=
# VENICE_API_KEY=
# CODEHARNESS_DECISION_API_BASE=
# CODEHARNESS_DECISION_MODEL=jev-latest
# CODEHARNESS_DECISION_TIMEOUT_MS=2000
# CODEHARNESS_DECISION_MIN_CONFIDENCE=0.0
# CODEHARNESS_DECISION_USES=loop_grade,verify
